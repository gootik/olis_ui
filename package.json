{
  "type": "module",
  "scripts": {
    "format": "prettier --write assets/js test/*.mjs examples/admin/assets/js \"assets/css/**/*.css\" \"examples/admin/assets/css/**/*.css\"",
    "format:check": "prettier --check assets/js test/*.mjs examples/admin/assets/js \"assets/css/**/*.css\" \"examples/admin/assets/css/**/*.css\"",
    "lint": "biome lint assets/js test examples/admin/assets/js",
    "test:js": "node --test test/*.mjs",
    "lint:css": "stylelint \"assets/css/**/*.css\" \"examples/admin/assets/css/**/*.css\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "^4.1.10",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.1.10"
  },
  "dependencies": {
    "@alpinejs/collapse": "3.17.5",
    "alpinejs": "3.17.5",
    "tw-animate-css": "1.4.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@tailwindcss/oxide@4.1.10": true
  }
}
